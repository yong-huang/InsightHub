  "cards": [
    {
      "dot": "cyan",
      "title": "浏览器单页应用",
      "items": [
        "React 19 + Vite 8 + TypeScript，无后端服务器、无 UI 组件库",
        "Zustand 状态与 FlexSearch 全文索引全部构建在浏览器内",
        "localStorage 是首选持久化，服务端数据仅做启动合并"
      ]
    },
    {
      "dot": "emerald",
      "title": "本地服务层",
      "items": [
        "documentDiscovery Vite 插件承担文档发现、REST 同步与 AI 代理",
        "生产构建改为静态托管：prebuild 将文档复制到 public/docs/",
        "工作区目录经 vite.config.ts 读取并加入 server.fs.allow 白名单"
      ]
    },
    {
      "dot": "amber",
      "title": "外部资源",
      "items": [
        "本地 OpenAI 兼容 LLM，支持 llama.cpp / Ollama / vLLM / LM Studio",
        "文档源目录与 .insighthub-*.json 数据文件都在本机磁盘",
        "多客户端指向同一 data/ 目录即获得 LAN 同步"
      ]
    }
  ]
